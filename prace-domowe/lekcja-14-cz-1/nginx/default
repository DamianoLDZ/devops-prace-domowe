server {
    listen 80 default_server;
    listen [::]:80 default_server;

    server_name twoja.local;

    root /home/damian/devops-prace-domowe/prace-domowe/lekcja-14-cz-1/www;
    index index.html;

    # Własne strony błędów
    error_page 404 /404.html;
    error_page 500 502 503 504 /50x.html;

    location = /404.html {
        internal;
    }

    location = /50x.html {
        internal;
    }

    location / {
        try_files $uri $uri/ =404;
    }
    # Autoindex nie jest włączony globalnie, ponieważ mógłby ujawniać strukturę katalogów i nazwy plików.
    # Wykaz plików udostępniamy tylko w wybranej lokalizacji, aby ograniczyć ryzyko ujawnienia poufnych danych.
    # Wykaz plików do pobrania
    location /pobierz/ {
        autoindex on;
        autoindex_exact_size off;
        autoindex_localtime on;
    }
}
